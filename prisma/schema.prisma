// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ユーザー（メンバー）
model User {
  id              String    @id @default(cuid())
  lineId          String?   @unique // LINE User ID
  name            String?   // NextAuth標準フィールド
  email           String?   @unique // NextAuth標準フィールド
  emailVerified   DateTime? // NextAuth標準フィールド
  image           String?   // NextAuth標準フィールド（プロフィール画像URL）
  nickname        String    @default("名無し") // ニックネーム（公開）
  firstName       String?   // 名（非公開）
  lastName        String?   // 姓（非公開）
  gender          String?   // 性別: male / female
  birthdate       DateTime? // 生年月日
  ageVisible      Boolean   @default(true) // 生年月日・年齢を公開するか
  profileImageUrl String?   // プロフィール画像URL（後方互換性）
  comment         String?   // その他コメント
  role            String    @default("pending") // admin / subadmin / member / visitor / guest / pending (承認待ち)
  lastActiveAt    DateTime? // 最終操作日時

  // 管理者専用フィールド（一般ユーザーには見えない）
  skillLevel      Int?      // スキルレベル: 1-10
  adminNote       String?   // 管理者メモ
  priorityScore   Int       @default(0) // キャンセル待ち繰り上げ優先度 (大きいほど先に繰り上げ)

  // 利用規約・プライバシーポリシーへの同意
  termsAcceptedAt      DateTime? // 同意した日時 (null = 未同意)
  termsAcceptedVersion String?   // 同意した規約バージョン (例: "2026-05-17")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // リレーション
  attendances     Attendance[]
  attendanceHistories AttendanceHistory[]
  createdEvents   Event[]      @relation("EventCreator")
  sentMessages    Message[]    @relation("MessageSender")

  // NextAuth用
  accounts        Account[]
  sessions        Session[]

  invitationToken InvitationToken?

  announcements   Announcement[] @relation("AnnouncementCreator")
  announcementReads AnnouncementRead[]

  createdTournaments Tournament[]       @relation("TournamentCreator")
  tournamentResults  TournamentResult[]
}

// NextAuth Account
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth Session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth VerificationToken
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// シャトル単価 (期間ごと)
// 1ケース = 10本 × 12個 = 120個 (shuttlesPerCase で変更可)
// イベント開催日 >= effectiveFrom の最大日付のレコードが適用される。
model ShuttlePrice {
  id              String   @id @default(cuid())
  effectiveFrom   DateTime // 適用開始日
  casePrice       Int      // ケース価格 (円)
  shuttlesPerCase Int      @default(120) // ケース内のシャトル個数
  memo            String?
  createdAt       DateTime @default(now())

  @@index([effectiveFrom])
}

// お知らせ
// 表示対象は non-admin role ごとに on/off。admin/subadmin は常に全件閲覧。
model Announcement {
  id              String   @id @default(cuid())
  title           String
  body            String
  audienceMember  Boolean  @default(true)
  audienceVisitor Boolean  @default(true)
  audienceGuest   Boolean  @default(true)
  severity        String   @default("info") // info / important
  publishedAt     DateTime @default(now())
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User? @relation("AnnouncementCreator", fields: [createdById], references: [id])
  reads     AnnouncementRead[]

  @@index([publishedAt])
}

// お知らせ既読マーカー (ユーザー × お知らせ)
model AnnouncementRead {
  userId         String
  announcementId String
  readAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@index([userId])
}

// イベント種別 (タグ)
model EventCategory {
  id              String   @id @default(cuid())
  name            String   @unique
  color           String?  // 例: "#3B82F6" (Tailwind blue-500)
  order           Int      @default(0) // 表示順 (小さい順)
  createdAt       DateTime @default(now())

  events    Event[]

  @@index([order])
}

// イベント
model Event {
  id              String    @id @default(cuid())
  title           String    // イベント名
  description     String?   // 説明
  eventDate       DateTime  // 開催日時
  eventEndDate    DateTime? // 終了日時（任意）
  isAllDay        Boolean   @default(false) // 終日イベント (時刻無視、表示は「終日」)
  location        String?   // 場所
  capacity        Int?      // 定員（nullなら無制限）
  fee             Int?      // 参加費（nullなら非表示）
  feeVisible      Boolean   @default(false) // 参加費を表示するか
  deadline        DateTime? // 締め切り日時
  deadlineEnabled Boolean   @default(false) // 締め切りを有効にするか
  respondStartAt  DateTime? // 回答開始日時 (null なら制限なし。前は回答不可)

  // イベント種別 (タグ)
  categoryId      String?
  category        EventCategory? @relation(fields: [categoryId], references: [id])

  // 閲覧・回答できる最低ロール (閾値方式)。
  //   minViewRole:    "guest" | "visitor" | "member"
  //   minRespondRole: "visitor" | "member" (guest は常に回答不可)
  // admin / subadmin は閾値に関わらず常にアクセス可。
  minViewRole     String    @default("visitor")
  minRespondRole  String    @default("visitor")

  // 中止フラグ (削除と区別。中止理由を後から見られるよう履歴として残す)
  cancelledAt     DateTime?
  cancelReason    String?

  // 経費・収支 (管理者用、イベント実施後に入力)
  shuttleCount    Int?      // 使用シャトル本数
  shuttleCost     Int?      // シャトル代合計
  gymCost         Int?      // 体育館代
  otherCost       Int?      // その他経費合計
  otherMemo       String?   // その他経費の内訳メモ
  actualRevenue   Int?      // 実際の集金額 (後日記録)

  createdById     String    // 作成者
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // リレーション
  createdBy       User         @relation("EventCreator", fields: [createdById], references: [id])
  attendances     Attendance[]
  attendanceHistories AttendanceHistory[]
  messages        Message[]
}

// 出欠
model Attendance {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  status      String   // attending / not_attending / waitlist
  comment     String?  // コメント
  position    Int?     // キャンセル待ち順（waitlistの場合）

  // 参加費 (admin が attending メンバーごとに記録)
  paymentStatus String? // paid / unpaid (null = 未確認)
  paymentAmount Int?    // null なら event.fee と同額。違う額を受け取った場合のみ手入力
  paymentNote   String? // メモ (任意)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // リレーション
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

// 出欠回答履歴（変更のたびに記録）
model AttendanceHistory {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  status      String   // attending / not_attending / waitlist / cancelled
  comment     String?  // コメント
  isProxy     Boolean  @default(false) // 管理者による代理登録
  changedAt   DateTime @default(now()) // 変更日時

  // リレーション
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([changedAt])
}

// 招待トークン（仮アカウントをLINEアカウントに紐づけるためのワンタイムトークン）
model InvitationToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// システム設定（key-value）
model SystemSetting {
  key   String @id
  value String
}

// メッセージ（対象者へのメッセージ送信用）
model Message {
  id          String   @id @default(cuid())
  eventId     String
  senderId    String
  targetType  String   // all / attending / not_attending / no_response
  content     String
  sentAt      DateTime @default(now())

  // リレーション
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
}

// 大会マスター。一般 (member) 以上が自分の出場した大会を登録する。
// 登録された大会はサービス管理者の承認 (approvalStatus = approved) を経て
// 一般メンバーから閲覧できるようになる。現状は同じサークル admin が承認するが、
// 将来は上位の「サービス管理者」ロールに権限を切り替える前提で
// approvalStatus / approvedById / approvedAt を別フィールドにしておく。
model Tournament {
  id          String   @id @default(cuid())
  name        String   // 大会名 (例: "足立区民バドミントン大会 2026春")
  heldAt      DateTime // 開催日
  // tier は TournamentClass 側に移動 (同じ大会でも 1部/2部 で Tier が変わる運用のため)
  openness    String   @default("open") // open / closed (参加区分: 出場資格の有無)
  prefecture  String?  // 47 都道府県 + overseas + other (開催地・都道府県)
  format      String   // tournament / league / league_then_tournament / other
  location    String?  // 会場 (自由テキスト)
  description String?  // 自由メモ
  createdById String

  // 承認ステータス: pending / approved / rejected
  approvalStatus String    @default("pending")
  approvedById   String?   // 承認した管理者の userId
  approvedAt     DateTime?
  rejectionReason String?  // 却下した場合の理由

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User                @relation("TournamentCreator", fields: [createdById], references: [id])
  classes   TournamentClass[]
  results   TournamentResult[]

  @@index([heldAt])
  @@index([createdById])
  @@index([approvalStatus])
}

// 大会の種目 × クラス。1 行は「この大会の MD 1部」のような単位を表す。
//   - category: 種目 (MS / WS / MD / WD / XD / other)
//   - name:     部・クラス名 ("1部" "2部" 等)。null = 該当種目にクラス分け無し
// 後から他のメンバーが「この大会には WD もあったはず」と気付いて追加できるよう、
// 1 行ずつ独立した承認ステータスを持つ。大会本体の作成と同時に登録された行は
// approvalStatus="approved" で入る (本体が approved になった瞬間に見える)。
// 後から追加された行は "pending" で入り、admin が個別に承認/却下する。
model TournamentClass {
  id             String   @id @default(cuid())
  tournamentId   String
  category       String   // MS / WS / MD / WD / XD / other
  name           String?  // null = この種目にクラス分け無し
  // Tier はこのクラスに対する実質的な強さの指標 (S / A / B / C / D / E / F / G)。
  // null は「分からない / 未指定」を意味し、admin が後で補完する想定。
  tier           String?
  order          Int      @default(0)

  approvalStatus String   @default("approved") // approved / pending
  proposalNote   String?  // 追加申請時のコメント (例: "公式サイトに WD あり" 等)
  createdById    String?  // 追加申請者。大会作成時に作られた行は null (= 大会作成者と同等扱い)
  approvedById   String?
  approvedAt     DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  results        TournamentResult[]

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([approvalStatus])
}

// 大会の個人成績。1 つの Tournament に対して N 個の Result。
// ダブルス・混合の相方はサークル外の人もあるので User FK にはせず文字列で保持。
// クラス分けがある大会では tournamentClassId を必ず指定する。
// クラス無し (例: XD のみ大会) のときだけ null を許容する。
model TournamentResult {
  id                String   @id @default(cuid())
  tournamentId      String
  tournamentClassId String?
  userId            String
  category          String   // MS / WS / MD / WD / XD / other
  rank              String?  // 自由テキスト: "優勝" "ベスト4" "1回戦敗退" など
  partnerName       String?  // ダブルス相方 (サークル外可)
  note              String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament      Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentClass TournamentClass? @relation(fields: [tournamentClassId], references: [id], onDelete: SetNull)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tournamentId])
  @@index([tournamentClassId])
}

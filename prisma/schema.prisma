// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ユーザー（メンバー）
model User {
  id              String    @id @default(cuid())
  lineId          String?   @unique // LINE User ID
  name            String?   // NextAuth標準フィールド
  email           String?   @unique // NextAuth標準フィールド
  emailVerified   DateTime? // NextAuth標準フィールド
  image           String?   // NextAuth標準フィールド（プロフィール画像URL）
  nickname        String    @default("名無し") // ニックネーム（公開）
  firstName       String?   // 名（非公開）
  lastName        String?   // 姓（非公開）
  gender          String?   // 性別: male / female
  age             Int?      // 年齢
  ageVisible      Boolean   @default(true) // 年齢を公開するか
  profileImageUrl String?   // プロフィール画像URL（後方互換性）
  comment         String?   // その他コメント
  role            String    @default("guest") // admin / subadmin / member / visitor / guest
  lastActiveAt    DateTime? // 最終操作日時

  // 管理者専用フィールド（一般ユーザーには見えない）
  skillLevel      Int?      // スキルレベル: 1-10
  adminNote       String?   // 管理者メモ

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // リレーション
  attendances     Attendance[]
  attendanceHistories AttendanceHistory[]
  createdEvents   Event[]      @relation("EventCreator")
  sentMessages    Message[]    @relation("MessageSender")

  // NextAuth用
  accounts        Account[]
  sessions        Session[]

  invitationToken InvitationToken?
}

// NextAuth Account
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth Session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth VerificationToken
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// イベント
model Event {
  id              String    @id @default(cuid())
  title           String    // イベント名
  description     String?   // 説明
  eventDate       DateTime  // 開催日時
  eventEndDate    DateTime? // 終了日時（任意）
  location        String?   // 場所
  capacity        Int?      // 定員（nullなら無制限）
  fee             Int?      // 参加費（nullなら非表示）
  feeVisible      Boolean   @default(false) // 参加費を表示するか
  deadline        DateTime? // 締め切り日時
  deadlineEnabled Boolean   @default(false) // 締め切りを有効にするか

  // 経費・収支 (管理者用、イベント実施後に入力)
  shuttleCount    Int?      // 使用シャトル本数
  shuttleCost     Int?      // シャトル代合計
  gymCost         Int?      // 体育館代
  otherCost       Int?      // その他経費合計
  otherMemo       String?   // その他経費の内訳メモ
  actualRevenue   Int?      // 実際の集金額 (後日記録)

  createdById     String    // 作成者
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // リレーション
  createdBy       User         @relation("EventCreator", fields: [createdById], references: [id])
  attendances     Attendance[]
  attendanceHistories AttendanceHistory[]
  messages        Message[]
}

// 出欠
model Attendance {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  status      String   // attending / not_attending / waitlist
  comment     String?  // コメント
  position    Int?     // キャンセル待ち順（waitlistの場合）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // リレーション
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

// 出欠回答履歴（変更のたびに記録）
model AttendanceHistory {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  status      String   // attending / not_attending / waitlist / cancelled
  comment     String?  // コメント
  isProxy     Boolean  @default(false) // 管理者による代理登録
  changedAt   DateTime @default(now()) // 変更日時

  // リレーション
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([changedAt])
}

// 招待トークン（仮アカウントをLINEアカウントに紐づけるためのワンタイムトークン）
model InvitationToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// システム設定（key-value）
model SystemSetting {
  key   String @id
  value String
}

// メッセージ（対象者へのメッセージ送信用）
model Message {
  id          String   @id @default(cuid())
  eventId     String
  senderId    String
  targetType  String   // all / attending / not_attending / no_response
  content     String
  sentAt      DateTime @default(now())

  // リレーション
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
}

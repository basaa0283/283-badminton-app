// Azure SQL Database用 Prisma schema
// 本番環境ではこのファイルを schema.prisma として使用

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ユーザー（メンバー）
model User {
  id              String    @id @default(cuid())
  lineId          String? // LINE User ID。一意性はフィルタ付きユニークインデックス (lineId IS NOT NULL) で担保 (手動管理)。schema には @unique を付けない (NULL 複数許容のため)。
  name            String?   // NextAuth標準フィールド
  email           String?   @unique // NextAuth標準フィールド
  emailVerified   DateTime? // NextAuth標準フィールド
  image           String?   @db.NVarChar(500) // NextAuth標準フィールド（プロフィール画像URL）
  nickname        String    @default("名無し") // ニックネーム（公開）
  firstName       String?   // 名（非公開）
  lastName        String?   // 姓（非公開）
  gender          String?   // 性別: male / female
  birthdate       DateTime? // 生年月日
  ageVisible      Boolean   @default(true) // 生年月日・年齢を公開するか
  profileImageUrl String?   @db.NVarChar(500) // プロフィール画像URL（後方互換性）
  comment         String?   @db.NVarChar(1000) // その他コメント
  role            String    @default("pending") // admin / subadmin / member / visitor / guest / pending (承認待ち)
  lastActiveAt    DateTime? // 最終操作日時

  // 管理者専用フィールド（一般ユーザーには見えない）
  skillLevel      Int?      // スキルレベル: 1-10
  adminNote       String?   @db.NVarChar(2000) // 管理者メモ
  priorityScore   Int       @default(0) // キャンセル待ち繰り上げ優先度 (大きいほど先に繰り上げ)
  tournamentResultsPublic Boolean @default(false) // 大会実績の全体公開スイッチ

  // ポイント制度 (P1)
  // lifetimePoints: 累積、減らない (経験値・ランキング用)
  // availablePoints: 有効、ペナルティで減る (キャンセル待ち優先度に直結予定)
  lifetimePoints  Int @default(0)
  availablePoints Int @default(10)

  // 利用規約・プライバシーポリシーへの同意
  termsAcceptedAt      DateTime? // 同意した日時 (null = 未同意)
  termsAcceptedVersion String?   @db.NVarChar(50) // 同意した規約バージョン (例: "2026-05-17")

  // 参加リクエスト保留 (pending ロールに対してのみ意味を持つ)
  holdAt              DateTime?
  holdMessageSentAt   DateTime?

  // メール通知 (任意登録)。notifyEmail は NextAuth の email とは独立 (unique なし)
  notifyEmail           String?
  notifyEmailVerifiedAt DateTime? // null = 未確認。未確認アドレスには送信しない
  notifyOnNewEvent      Boolean   @default(true)
  notifyOnAnnouncement  Boolean   @default(true)
  notifyOnReminder      Boolean   @default(true)
  notifyOnEventMessage  Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // リレーション
  attendances          Attendance[]
  attendanceHistories  AttendanceHistory[]
  createdEvents        Event[]      @relation("EventCreator")
  sentMessages         Message[]    @relation("MessageSender")

  // NextAuth用
  accounts        Account[]
  sessions        Session[]

  invitationToken InvitationToken?

  announcements   Announcement[] @relation("AnnouncementCreator")
  announcementReads AnnouncementRead[]

  createdTournaments Tournament[]       @relation("TournamentCreator")
  tournamentResults  TournamentResult[]

  activityLogs       ActivityLog[]

  memberTags         UserMemberTag[]

  pointTransactions  PointTransaction[]
  achievementUnlocks AchievementUnlock[]
}

// ポイント増減の履歴。設計 docs/superpowers/specs/2026-06-11-points-achievements-cancel-design.md 参照。
// reason 命名: "signup.bonus" / "event.attendance" / "cancel.same_day_with_notice" など
model PointTransaction {
  id         String   @id @default(cuid())
  userId     String
  delta      Int      // 正=加算、負=減算。0 はレコードを作らない
  reason     String   @db.NVarChar(100)
  entityType String?  @db.NVarChar(50)
  entityId   String?
  createdAt  DateTime @default(now())

  // SQL Server 循環参照対策: user は NoAction
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@index([reason])
}

// 実績バッジ解除レコード。achievementId は src/lib/achievements.ts の定数 ID。
model AchievementUnlock {
  userId        String
  achievementId String   @db.NVarChar(100)
  unlockedAt    DateTime @default(now())

  // SQL Server 循環参照対策: user は NoAction
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, achievementId])
  @@index([achievementId])
}

// メンバーに振るタグ (管理者管理)。イベントを「このタグ持ちだけに公開」する用途。
model MemberTag {
  id          String   @id @default(cuid())
  name        String   @unique @db.NVarChar(100)
  description String?  @db.NVarChar(500)
  color       String?  @db.NVarChar(20)
  createdAt   DateTime @default(now())

  users  UserMemberTag[]
  events EventAllowedTag[]
}

model UserMemberTag {
  userId    String
  tagId     String
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  MemberTag @relation(fields: [tagId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, tagId])
  @@index([tagId])
}

model EventAllowedTag {
  eventId   String
  tagId     String
  createdAt DateTime @default(now())

  event Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag   MemberTag @relation(fields: [tagId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([eventId, tagId])
  @@index([tagId])
}

// アプリ内の操作ログ。利用状況分析と監査の両方に使う汎用テーブル。
// - action は "domain.verb" の命名 (例: "tournament.create", "tournament.list_view")
// - entityType / entityId は対象レコードがある場合のみ
// - metadata はフィルタ条件や変更差分などの追加情報を JSON 文字列で
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   String?  @db.NVarChar(Max)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// NextAuth Account
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.NVarChar(Max)
  access_token      String? @db.NVarChar(Max)
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.NVarChar(Max)
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth Session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth VerificationToken
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// シャトル単価 (期間ごと)
// 1ケース = 10本 × 12個 = 120個 (shuttlesPerCase で変更可)
// イベント開催日 >= effectiveFrom の最大日付のレコードが適用される。
model ShuttlePrice {
  id              String   @id @default(cuid())
  effectiveFrom   DateTime // 適用開始日
  casePrice       Int      // ケース価格 (円)
  shuttlesPerCase Int      @default(120) // ケース内のシャトル個数
  memo            String?  @db.NVarChar(500)
  createdAt       DateTime @default(now())

  @@index([effectiveFrom])
}

// お知らせ (イベント紐付き "当日連絡" にも使う)
model Announcement {
  id              String   @id @default(cuid())
  title           String   @db.NVarChar(200)
  body            String   @db.NVarChar(4000)
  audienceMember  Boolean  @default(true)
  audienceVisitor Boolean  @default(true)
  audienceGuest   Boolean  @default(true)
  severity        String   @default("info")
  publishedAt     DateTime @default(now())
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // イベント紐付き "当日連絡" 用 (任意)
  eventId              String?
  attendanceTargetType String?  @db.NVarChar(50)

  createdBy User?  @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event     Event? @relation("EventAnnouncements", fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reads     AnnouncementRead[]

  @@index([publishedAt])
  @@index([eventId])
}

// お知らせ既読マーカー
model AnnouncementRead {
  userId         String
  announcementId String
  readAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@index([userId])
}

// イベント種別 (タグ)
model EventCategory {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?  @db.NVarChar(Max) // タグの説明文 (ホバー/タップで表示)
  color           String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  events    Event[]

  @@index([order])
}

// イベント
model Event {
  id              String    @id @default(cuid())
  title           String    // イベント名
  description     String?   @db.NVarChar(2000) // 説明
  eventDate       DateTime  // 開催日時
  eventEndDate    DateTime? // 終了日時（任意）
  isAllDay        Boolean   @default(false) // 終日イベント
  location        String?   // 場所
  capacity        Int?      // 定員（nullなら無制限）
  fee             Int?      // 参加費（nullなら非表示）
  feeVisible      Boolean   @default(false) // 参加費を表示するか
  deadline        DateTime? // 締め切り日時
  deadlineEnabled Boolean   @default(false) // 締め切りを有効にするか
  respondStartAt  DateTime? // 回答開始日時 (null なら制限なし)

  // イベント種別 (タグ)
  categoryId      String?
  category        EventCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // 閲覧・回答できる最低ロール (閾値方式)。
  //   minViewRole:    "guest" | "visitor" | "member"
  //   minRespondRole: "visitor" | "member" (guest は常に回答不可)
  // admin / subadmin は閾値に関わらず常にアクセス可。
  minViewRole     String    @default("visitor")
  minRespondRole  String    @default("visitor")

  // 中止フラグ
  cancelledAt     DateTime?
  cancelReason    String?  @db.NVarChar(500)

  // 公開状態 (draft = 管理者・作成者のみ、published = 通常公開)
  status          String   @default("published") @db.NVarChar(20)

  // 経費・収支 (管理者用、イベント実施後に入力)
  shuttleCount    Int?      // 使用シャトル本数
  shuttleCost     Int?      // シャトル代合計
  gymCost         Int?      // 体育館代
  otherCost       Int?      // その他経費合計
  otherMemo       String?   @db.NVarChar(500) // その他経費の内訳メモ
  actualRevenue   Int?      // 実際の集金額 (後日記録)

  // ポイント制度: イベント参加完了時の追加ボーナス pt (null/0 = 基本値のみ)
  attendanceBonusPoints Int?

  createdById     String    // 作成者
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // 紐付く大会 (任意)。大会登録時に「参加表明用イベントを作る」を選ぶと
  // セットされる。
  linkedTournamentId String?
  linkedTournament   Tournament? @relation("EventTournamentLink", fields: [linkedTournamentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // リレーション
  createdBy           User         @relation("EventCreator", fields: [createdById], references: [id])
  attendances         Attendance[]
  attendanceHistories AttendanceHistory[]
  messages            Message[]
  allowedTags         EventAllowedTag[]
  announcements       Announcement[] @relation("EventAnnouncements")

  @@index([linkedTournamentId])
  @@index([eventDate])
}

// 出欠
model Attendance {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  status      String   // attending / not_attending / waitlist
  comment     String?  @db.NVarChar(500) // コメント
  position    Int?     // キャンセル待ち順（waitlistの場合）

  // 大会連動イベント時の申告クラス (TournamentClass.id を保管、参照整合性は強制せず)
  declaredTournamentClassId String?

  // 参加費 (admin が attending メンバーごとに記録)
  paymentStatus String? // paid / unpaid (null = 未確認)
  paymentAmount Int?    // null なら event.fee と同額
  paymentNote   String? @db.NVarChar(500)

  // キャンセルの質 (P2/P3): regular / same_day_with_notice / same_day_no_notice / no_show
  cancelType    String? @db.NVarChar(50)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // リレーション（SQL Server循環参照対策: userはNoAction）
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

// 出欠回答履歴（変更のたびに記録）
model AttendanceHistory {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  status      String   // attending / not_attending / waitlist / cancelled
  comment     String?  @db.NVarChar(500) // コメント
  isProxy     Boolean  @default(false) // 管理者による代理登録
  // キャンセルの質 (P1)
  // "regular" | "same_day_with_notice" | "same_day_no_notice" | "no_show"
  cancelType  String?  @db.NVarChar(50)
  changedAt   DateTime @default(now()) // 変更日時

  // リレーション（SQL Server循環参照対策: userはNoAction）
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([changedAt])
}

// メール確認・配信停止用トークン
// User へのリレーションは意図的に張らない (削除時の FK 問題回避)。
// ユーザー削除時は src/lib/user-delete.ts の deleteUserCascade で明示削除する。
model EmailToken {
  token     String    @id
  userId    String
  purpose   String    @db.NVarChar(20) // "verify" (24h期限) | "unsubscribe" (無期限)
  expiresAt DateTime? // null = 無期限
  createdAt DateTime  @default(now())

  @@index([userId])
}

// 招待トークン
model InvitationToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// システム設定（key-value）
model SystemSetting {
  key   String @id
  value String @db.NVarChar(Max)
}

// メッセージ（対象者へのメッセージ送信用）
model Message {
  id          String   @id @default(cuid())
  eventId     String
  senderId    String
  targetType  String   // all / attending / not_attending / no_response
  content     String   @db.NVarChar(2000)
  sentAt      DateTime @default(now())

  // リレーション（SQL Server循環参照対策: senderはNoAction）
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// 大会マスター。一般 (member) 以上が自分の出場した大会を登録する。
// 承認 (approvalStatus = approved) されるまで一般メンバーには見せない。
model Tournament {
  id          String   @id @default(cuid())
  name        String   @db.NVarChar(200)
  heldAt      DateTime
  // tier は TournamentClass 側に移動
  openness    String   @default("open") @db.NVarChar(20) // open / closed
  prefecture  String?  @db.NVarChar(20)  // 47都道府県 / overseas / other
  format      String   @db.NVarChar(50)
  location    String?  @db.NVarChar(200)
  description String?  @db.NVarChar(2000)
  createdById String

  approvalStatus  String    @default("pending") @db.NVarChar(20) // pending / approved / rejected
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?   @db.NVarChar(500)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // SQL Server の multi-cascade-path を避けるため createdBy / approvedBy は NoAction
  createdBy User                @relation("TournamentCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classes   TournamentClass[]
  results   TournamentResult[]
  linkedEvents Event[]           @relation("EventTournamentLink")

  @@index([heldAt])
  @@index([createdById])
  @@index([approvalStatus])
}

// 大会の種目 × クラス。1 行は「この大会の MD 1部」を表す。
// 追加申請を受け付けるため、行単位で approvalStatus を持つ。
model TournamentClass {
  id             String   @id @default(cuid())
  tournamentId   String
  category       String   @db.NVarChar(20)  // MS / WS / MD / WD / XD / other
  name           String?  @db.NVarChar(50)  // "1部" "2部" 等、null = クラス分け無し
  tier           String?  @db.NVarChar(20)  // S / A / B / C / D / E / F / G、null = 未指定
  order          Int      @default(0)

  approvalStatus String   @default("approved") @db.NVarChar(20)
  proposalNote   String?  @db.NVarChar(500)
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  results        TournamentResult[]

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([approvalStatus])
}

// 大会の個人成績。
model TournamentResult {
  id                String   @id @default(cuid())
  tournamentId      String
  tournamentClassId String?
  userId            String
  category          String   @db.NVarChar(20)
  rank              String?  @db.NVarChar(100)
  partnerName       String?  @db.NVarChar(100)
  note              String?  @db.NVarChar(2000)
  isPublic          Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // tournament 側は Cascade、class / user は NoAction で multi-cascade-path を回避
  tournament      Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentClass TournamentClass? @relation(fields: [tournamentClassId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user            User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([tournamentId])
  @@index([tournamentClassId])
}
